import crypto from 'crypto';

// --- TYPES & INTERFACES ---

export interface VehiclePermit {
  plateNumber: string;
  maxSeats: number;
  councilPermitActive: boolean;
  zimraFdmsFiscalized: boolean;
}

export interface DriverScorecard {
  driverId: string;
  driverName: string;
  points: number; // Max 100
  activeShiftToken: string | null;
}

export type RoadType = 'SUBURBAN' | 'HIGHWAY';

export interface TelemetryPing {
  vehicleId: string;
  currentSpeedKmH: number;
  roadType: RoadType;
  durationOverSpeedSec: number;
}

export interface ZrpAlertPayload {
  timestamp: string;
  plateNumber: string;
  driverId: string;
  currentLocation: { lat: number; lng: number };
  recordedSpeed: number;
  demeritScore: number;
  reason: string;
}

// --- MOCK DATABASE STATE ---

const VEHICLE_REGISTRY: Record<string, VehiclePermit> = {
  'AGE-3109': {
    plateNumber: 'AGE-3109',
    maxSeats: 14,
    councilPermitActive: true,
    zimraFdmsFiscalized: true,
  },
};

const DRIVER_REGISTRY: Record<string, DriverScorecard> = {
  'DRV-8812': {
    driverId: 'DRV-8812',
    driverName: 'Pangoma',
    points: 85,
    activeShiftToken: 'SHIFT-INITIAL-TOKEN',
  },
};

const SECRET_HMAC_KEY = 'mushikashika-secret-key-mbare-rank';

// --- CORE TERMINAL ENGINE ---

export class MushikashikaTerminalEngine {
  
  /**
   * Module A: Overloading Hard Lock & HMAC Token Dispatch
   */
  public dispatchVehicle(
    plateNumber: string,
    passengerCount: number,
    driverId: string
  ): { success: boolean; token?: string; message: string } {
    const vehicle = VEHICLE_REGISTRY[plateNumber];
    const driver = DRIVER_REGISTRY[driverId];

    if (!vehicle) return { success: false, message: 'Vehicle not registered' };
    if (!driver) return { success: false, message: 'Driver not found' };

    // Tax & Permit checks
    if (!vehicle.councilPermitActive || !vehicle.zimraFdmsFiscalized) {
      return { success: false, message: 'REJECTED: Invalid City Council Permit or ZIMRA FDMS Status' };
    }

    // Driver Score Check
    if (driver.points < 40) {
      return { success: false, message: 'REJECTED: Driver score critical (<40). Active shift revoked.' };
    }

    // OVERLOADING HARD LOCK
    if (passengerCount > vehicle.maxSeats) {
      return {
        success: false,
        message: `OVERLOAD DETECTED: Passenger count (${passengerCount}) exceeds capacity (${vehicle.maxSeats}). Dispatch token locked!`,
      };
    }

    // Generate Cryptographically Signed Offline HMAC Shift Clearance
    const timestamp = Date.now();
    const payload = `${plateNumber}:${driverId}:${passengerCount}:${timestamp}`;
    const hmacToken = crypto.createHmac('sha256', SECRET_HMAC_KEY).update(payload).digest('hex').substring(0, 16);

    driver.activeShiftToken = hmacToken;

    return {
      success: true,
      token: `HMAC-${hmacToken.toUpperCase()}`,
      message: 'PFACCHA / WAVHA! HMAC Shift Token Generated (Valid 15m)',
    };
  }

  /**
   * Module B & C: Dynamic Speed Engine (SI 118) & Demerit System
   */
  public processInTransitTelemetry(
    telemetry: TelemetryPing,
    location: { lat: number; lng: number }
  ): { status: string; driverPoints: number; alertTriggered: boolean } {
    const { vehicleId, currentSpeedKmH, roadType, durationOverSpeedSec } = telemetry;
    const driver = DRIVER_REGISTRY['DRV-8812'];

    // SI 118 Caps: Suburban 60km/h | Highway 80km/h (PSV limit)
    const maxAllowedSpeed = roadType === 'SUBURBAN' ? 60 : 80;
    const speedDelta = currentSpeedKmH - maxAllowedSpeed;

    // Grace Window: Allows temporary acceleration (e.g. <= 5 seconds for overtaking)
    if (speedDelta > 0 && durationOverSpeedSec > 5) {
      let penalty = 0;

      if (speedDelta >= 20) {
        penalty = 25; // Severe infraction
      } else if (speedDelta >= 5) {
        penalty = 10; // Moderate infraction
      }

      driver.points = Math.max(0, driver.points - penalty);

      // Revoke shift token if points drop into critical zone (<40)
      if (driver.points < 40) {
        driver.activeShiftToken = null;
        this.triggerZrpAlert({
          timestamp: new Date().toISOString(),
          plateNumber: vehicleId,
          driverId: driver.driverId,
          currentLocation: location,
          recordedSpeed: currentSpeedKmH,
          demeritScore: driver.points,
          reason: `CRITICAL DEMERIT SCORE: Driver points dropped to ${driver.points}. Sustained speeding (${currentSpeedKmH} km/h in ${roadType} zone).`,
        });

        return { status: 'SHIFT_REVOKED_ZRP_ALERTED', driverPoints: driver.points, alertTriggered: true };
      }

      return { status: `PENALIZED_-${penalty}_PTS`, driverPoints: driver.points, alertTriggered: false };
    }

    return { status: 'NORMAL', driverPoints: driver.points, alertTriggered: false };
  }

  /**
   * Module D: Real-time ZRP Interception Alert Dispatch
   */
  private triggerZrpAlert(alert: ZrpAlertPayload) {
    console.warn('=============================================================');
    console.warn('🚨 ZRP TRAFFIC CHECKPOINT INTERCEPTION ALERT DISPATCHED 🚨');
    console.warn(`PLATE: ${alert.plateNumber} | DRIVER: ${alert.driverId}`);
    console.warn(`SPEED: ${alert.recordedSpeed} km/h | DEMERIT SCORE: ${alert.demeritScore}/100`);
    console.warn(`GPS: [${alert.currentLocation.lat}, ${alert.currentLocation.lng}]`);
    console.warn(`REASON: ${alert.reason}`);
    console.warn('=============================================================');
  }

  /**
   * Render Localized Sabhuku Terminal Mockup View
   */
  public renderSabhukuScreen(plateNumber: string, passengerCount: number, driverId: string): string {
    const vehicle = VEHICLE_REGISTRY[plateNumber] || { maxSeats: 14, councilPermitActive: true, zimraFdmsFiscalized: true };
    const driver = DRIVER_REGISTRY[driverId] || { driverName: 'Unknown', points: 85 };
    const isOverloaded = passengerCount > vehicle.maxSeats;

    const stars = '★'.repeat(Math.round(driver.points / 20)) + '☆'.repeat(5 - Math.round(driver.points / 20));

    return `
=============================================================
             NJANJI TRANSIT TERMINAL v2.4
             [Sabhuku Role: Active | Mbare Rank]
=============================================================

 VEHICLE:     Toyota HiAce [ Reg: ${plateNumber} ]
 PERMIT:      ${vehicle.councilPermitActive ? 'City Council Route Disk Active' : 'EXPIRED'}
 TAX:         ${vehicle.zimraFdmsFiscalized ? 'ZIMRA FDMS Fiscalised' : 'UNPAID'}

 PASSENGER COUNT:
 [ - ]   ${passengerCount} / ${vehicle.maxSeats} Max Seats   [ + ]  --> STATUS: ${isOverloaded ? '❌ OVERLOAD DETECTED' : '✅ VALID'}

 DRIVER SAFETY SCORE:
 [${stars}] ${driver.points}/100 Points (${driver.driverName} / ${driver.points >= 40 ? 'Active Shift' : 'Revoked'})

-------------------------------------------------------------
 [ ACTION: DISPATCH "PFACCHA / WAVHA" ]
 -> ${isOverloaded ? 'DISPATCH LOCKED (Reduce passengers)' : 'Generates HMAC Shift Token (Valid for 15 mins at Gate)'}
=============================================================
`;
  }
}
