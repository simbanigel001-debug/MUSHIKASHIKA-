-- Enable PostGIS extension for spatial queries
CREATE EXTENSION IF NOT EXISTS postgis;

-- Ranks / Terminals Geofence Table
CREATE TABLE IF NOT EXISTS bus_ranks (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(100) NOT NULL,
    code VARCHAR(20) UNIQUE NOT NULL,
    boundary GEOMETRY(Polygon, 4326) NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- Index for high-speed spatial lookup
CREATE INDEX IF NOT EXISTS idx_bus_ranks_boundary ON bus_ranks USING GIST(boundary);

-- Telemetry Stop Events Ingested from Mobile Queue
CREATE TABLE IF NOT EXISTS telemetry_stops (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    shift_id UUID NOT NULL,
    vehicle_id UUID NOT NULL,
    recorded_at TIMESTAMP WITH TIME ZONE NOT NULL,
    location GEOMETRY(Point, 4326) NOT NULL,
    dwell_duration_seconds INTEGER NOT NULL,
    max_speed_before_stop_kmh NUMERIC(5,2),
    is_mock_location BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- Spatial Index on stops
CREATE INDEX IF NOT EXISTS idx_telemetry_stops_location ON telemetry_stops USING GIST(location);

-- Speed Violations Ingested
CREATE TABLE IF NOT EXISTS speed_violations (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    shift_id UUID NOT NULL,
    vehicle_id UUID NOT NULL,
    recorded_at TIMESTAMP WITH TIME ZONE NOT NULL,
    location GEOMETRY(Point, 4326) NOT NULL,
    recorded_speed_kmh NUMERIC(5,2) NOT NULL,
    speed_limit_kmh NUMERIC(5,2) NOT NULL
);
