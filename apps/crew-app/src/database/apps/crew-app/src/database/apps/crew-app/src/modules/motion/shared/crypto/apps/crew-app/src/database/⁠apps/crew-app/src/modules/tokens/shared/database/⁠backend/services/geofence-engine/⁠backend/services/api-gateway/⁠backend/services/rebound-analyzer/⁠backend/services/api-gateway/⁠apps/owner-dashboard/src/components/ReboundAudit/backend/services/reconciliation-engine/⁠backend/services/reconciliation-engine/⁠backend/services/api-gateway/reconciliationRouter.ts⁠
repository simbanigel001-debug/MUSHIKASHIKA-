import { Router, Request, Response } from 'express';
import { Pool } from 'pg';
import { ReconciliationEngine, ShiftFinancialsInput } from '../reconciliation-engine/ReconciliationEngine';

export const createReconciliationRouter = (dbPool: Pool) => {
  const router = Router();

  router.post('/cashup', async (req: Request, res: Response) => {
    const input: ShiftFinancialsInput = req.body;

    if (!input.shiftId || input.grossFaresCollected == null || input.actualCashHandedOver == null) {
      return res.status(400).json({ error: 'Missing required shift financial fields.' });
    }

    try {
      // Execute the reconciliation logic
      const summary = ReconciliationEngine.processShiftReconciliation(input);

      // Save reconciliation audit into PostgreSQL
      const client = await dbPool.connect();
      try {
        await client.query(
          `INSERT INTO shift_reconciliations 
           (shift_id, gross_revenue, approved_expenses, expected_cash_target, actual_cash_handed_over, shortage_surplus, is_approved, audit_data)
           VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
           ON CONFLICT (shift_id) DO UPDATE SET
             expected_cash_target = EXCLUDED.expected_cash_target,
             actual_cash_handed_over = EXCLUDED.actual_cash_handed_over,
             shortage_surplus = EXCLUDED.shortage_surplus,
             is_approved = EXCLUDED.is_approved,
             audit_data = EXCLUDED.audit_data;`,
          [
            summary.shiftId,
            summary.grossRevenue,
            summary.totalApprovedExpenses,
            summary.expectedCashTarget,
            summary.actualCashHandedOver,
            summary.cashShortageOrSurplus,
            summary.isShiftApproved,
            JSON.stringify(summary)
          ]
        );
      } finally {
        client.release();
      }

      return res.status(200).json({ success: true, reconciliation: summary });
    } catch (error) {
      console.error('Failed to process shift reconciliation:', error);
      return res.status(500).json({ error: 'Internal reconciliation processing failure.' });
    }
  });

  return router;
};
