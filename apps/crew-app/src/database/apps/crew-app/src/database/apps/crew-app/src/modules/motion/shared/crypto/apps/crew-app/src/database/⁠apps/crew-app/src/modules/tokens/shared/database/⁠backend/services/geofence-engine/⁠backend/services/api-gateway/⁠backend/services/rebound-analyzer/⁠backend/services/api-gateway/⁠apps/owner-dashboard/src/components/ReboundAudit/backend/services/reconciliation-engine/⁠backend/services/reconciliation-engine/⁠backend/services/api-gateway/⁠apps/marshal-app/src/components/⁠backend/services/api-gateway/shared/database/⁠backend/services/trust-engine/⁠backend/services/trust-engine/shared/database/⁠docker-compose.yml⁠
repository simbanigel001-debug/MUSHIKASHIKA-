version: '3.8'

services:
  # PostGIS Database Engine for Telemetry & Rank Geo-Fencing
  postgres:
    image: postgis/postgis:15-3.3
    container_name: kombi_postgres
    restart: always
    environment:
      POSTGRES_USER: kombi_admin
      POSTGRES_PASSWORD: secret_db_password_2026
      POSTGRES_DB: kombi_fleet_db
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./shared/database:/docker-entrypoint-initdb.d
    networks:
      - kombi_network

  # Redis for Real-Time Fare State & Websocket Pub/Sub
  redis:
    image: redis:7-alpine
    container_name: kombi_redis
    restart: always
    ports:
      - "6379:6379"
    volumes:
      - redisdata:/data
    networks:
      - kombi_network

  # Main Node.js API Gateway & Real-Time Sync Server
  api-gateway:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: kombi_api_gateway
    restart: always
    ports:
      - "4000:4000"
    environment:
      NODE_ENV: production
      PORT: 4000
      DATABASE_URL: postgres://kombi_admin:secret_db_password_2026@postgres:5432/kombi_fleet_db
      REDIS_URL: redis://redis:6379
      QR_HMAC_SECRET: zim-harare-fleet-hmac-key-2026
    depends_on:
      - postgres
      - redis
    networks:
      - kombi_network

networks:
  kombi_network:
    driver: bridge

volumes:
  pgdata:
  redisdata:
